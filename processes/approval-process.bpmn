        <di:waypoint x="218" y="240" />
        <di:waypoint x="300" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0anz7ku_di" bpmnElement="Flow_0anz7ku">
        <di:waypoint x="400" y="240" />
        <di:waypoint x="450" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0u9btp0_di" bpmnElement="Flow_0u9btp0">
        <di:waypoint x="550" y="240" />
        <di:waypoint x="605" y="240" />
      </bpmndi:BPMNEdge>
